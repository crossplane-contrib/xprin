{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
  ],
  ignorePresets: [
    ':ignoreModulesAndTests',
  ],
  // We only want renovate to rebase PRs when they have conflicts, default
  // "auto" mode is not required.
  rebaseWhen: 'conflicted',
  // The maximum number of PRs to be created in parallel
  prConcurrentLimit: 5,
  // The branches renovate should target
  // PLEASE UPDATE THIS WHEN RELEASING.
  baseBranchPatterns: [
    'main',
  ],
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  // All PRs should have a label
  labels: [
    'automated',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Bump Earthly version in GitHub workflows',
      managerFilePatterns: [
        '/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        "EARTHLY_VERSION: '(?<currentValue>.*?)'\\n",
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'earthly/earthly',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: 'Bump Go version in Earthfile',
      managerFilePatterns: [
        '/^Earthfile$/',
      ],
      matchStrings: [
        'ARG --global GO_VERSION=(?<currentValue>.*?)\\n',
      ],
      datasourceTemplate: 'golang-version',
      depNameTemplate: 'golang',
    },
    {
      customType: 'regex',
      description: 'Bump golangci-lint version in the Earthfile',
      managerFilePatterns: [
        '/^Earthfile$/',
      ],
      matchStrings: [
        'ARG GOLANGCI_LINT_VERSION=(?<currentValue>.*?)\\n',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'golangci/golangci-lint',
    },
    {
      customType: 'regex',
      description: 'Bump E2E Crossplane v1 version in Earthfile',
      managerFilePatterns: [
        '/^Earthfile$/',
      ],
      matchStrings: [
        'ARG --global E2E_CROSSPLANE_V1=(?<currentValue>.*?)\\n',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'crossplane/crossplane-e2e-v1',
      packageNameTemplate: 'crossplane/crossplane',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: 'Bump E2E Crossplane controller version in Earthfile (tracks crossplane/crossplane)',
      managerFilePatterns: [
        '/^Earthfile$/',
      ],
      matchStrings: [
        'ARG --global E2E_CROSSPLANE_V2=(?<currentValue>.*?)\\n',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'crossplane/crossplane-e2e-v2',
      packageNameTemplate: 'crossplane/crossplane',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: 'Bump E2E Crossplane current CLI version in Earthfile (crossplane/cli v2.3+)',
      managerFilePatterns: [
        '/^Earthfile$/',
      ],
      matchStrings: [
        'ARG --global E2E_CROSSPLANE_CLI=(?<currentValue>.*?)\\n',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'crossplane/crossplane-e2e-cli',
      packageNameTemplate: 'crossplane/cli',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'jsonata',
      description: 'Bump Crossplane provider versions in crossplane.yaml spec.dependsOn',
      fileFormat: 'yaml',
      managerFilePatterns: [
        '/^examples\\/(aws|gcp|base)\\/crossplane\\.yaml$/',
      ],
      matchStrings: [
        'spec.dependsOn.{ "depName": package, "currentValue": version, "depType": "provider" }',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  // Renovate doesn't have native Earthfile support, but because Earthfile
  // syntax is a superset of Dockerfile syntax this works to update FROM images.
  // https://github.com/renovatebot/renovate/issues/15975
  dockerfile: {
    managerFilePatterns: [
      '/(^|/)Earthfile$/',
    ],
  },
  crossplane: {
    managerFilePatterns: [
      '/(^|/)examples/(aws|gcp|base)/.*\\.yaml$/',
    ],
  },
  // PackageRules disabled below should be enabled in case of vulnerabilities
  vulnerabilityAlerts: {
    enabled: true,
  },
  osvVulnerabilityAlerts: true,
  // Renovate evaluates all packageRules in order, so low priority rules should
  // be at the beginning, high priority at the end
  packageRules: [
    {
      matchManagers: [
        'crossplane',
        'custom.jsonata',
      ],
      matchFileNames: [
        'examples/aws/**',
        'examples/gcp/**',
        'examples/base/**',
      ],
      groupName: 'example-manifests',
    },
    {
      description: 'E2E Crossplane v1 (Earthfile): only 1.x',
      matchDepNames: [
        'crossplane/crossplane-e2e-v1',
      ],
      allowedVersions: '<2.0',
      ignoreUnstable: true,
    },
    {
      description: 'Only get Docker image updates every 2 weeks to reduce noise',
      matchDatasources: [
        'docker',
      ],
      schedule: [
        'every 2 week on monday',
      ],
      enabled: true,
    },
    {
      description: 'Ignore k8s.io/client-go older versions, they switched to semantic version and old tags are still available in the repo',
      matchDatasources: [
        'go',
      ],
      matchDepNames: [
        'k8s.io/client-go',
      ],
      allowedVersions: '<1.0',
    },
    {
      description: 'Ignore k8s dependencies, should be updated on crossplane-runtime',
      matchDatasources: [
        'go',
      ],
      enabled: false,
      matchPackageNames: [
        'k8s.io{/,}**',
        'sigs.k8s.io{/,}**',
      ],
    },
    {
      description: 'Only get dependency digest updates every month to reduce noise, except crossplane packages',
      matchDatasources: [
        'go',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      extends: [
        'schedule:monthly',
      ],
      excludePackagePatterns: [
        'github\\.com/crossplane/.*',
      ],
    },
    {
      description: 'Group all crossplane go modules (go.mod): versions are independent',
      matchPackageNames: [
        'github.com/crossplane/crossplane/apis/v2',
        'github.com/crossplane/crossplane-runtime/v2',
        'github.com/crossplane/cli/v2',
      ],
      groupName: 'Crossplane',
    },
    {
      description: 'Group E2E Crossplane Earthfile versions with go.mod updates',
      matchDepNames: [
        'crossplane/crossplane-e2e-v2',
        'crossplane/crossplane-e2e-cli',
      ],
      groupName: 'Crossplane',
    },
    {
      description: 'E2E Crossplane current CLI (Earthfile): only v2.3+',
      matchDepNames: [
        'crossplane/crossplane-e2e-cli',
      ],
      allowedVersions: '>=2.3',
      ignoreUnstable: true,
    },
    {
      description: 'Group all GitHub Actions updates',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
    },
    {
      description: 'Group all go version updates',
      matchDatasources: [
        'golang-version',
      ],
      groupName: 'golang version',
    },
  ],
}
